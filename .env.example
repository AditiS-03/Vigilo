# Vigilo Environment Configuration Example
# Copy to .env and configure your keys

# Server
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=info

# Google Gemini API Key (Required for AI explanations, Response Agent reasoning, and Coach challenge generation)
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Threat Intelligence (Optional external reputation checks, e.g., VirusTotal or SafeBrowsing)
# If empty or invalid, Vigilo gracefully falls back to ML + rule-based heuristics
THREAT_INTEL_API_KEY=
THREAT_INTEL_PROVIDER=none

# Database (Optional Supabase / PostgreSQL connection URI)
# If empty, Vigilo automatically initializes and uses a fast local SQLite database with initial seed data
DATABASE_URL=

# Adaptive Protection Defaults
GAMING_WARNING_THRESHOLD=55
PHISHING_WARNING_THRESHOLD=60
DOWNLOAD_WARNING_THRESHOLD=50
DEFAULT_WARNING_THRESHOLD=70
