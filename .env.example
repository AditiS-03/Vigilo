# ==============================================================================
# VIGILO PARENT DEFENSE - ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# --- AI Engine (Google Gemini) ---
# Primary API key for AI safety reasoning, dynamic coach scenario generation,
# and child-friendly risk explanations.
# Where to obtain: https://aistudio.google.com/app/apikey (Google AI Studio)
GEMINI_API_KEY=

# Model alias to use for safety analysis and coaching generation.
GEMINI_MODEL=gemini-2.5-flash

# --- Adaptive Protection Thresholds (0 - 100) ---
GAMING_WARNING_THRESHOLD=55
PHISHING_WARNING_THRESHOLD=60
DOWNLOAD_WARNING_THRESHOLD=50
DEFAULT_WARNING_THRESHOLD=70

# --- Server & Runtime Config ---
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# --- Optional Threat Intelligence Integrations ---
THREAT_INTEL_PROVIDER=internal
THREAT_INTEL_API_KEY=09aacad605f3e8fe17246fb9ce19d5335c5a5fea07838fb71edb2fb47309cc8d

# --- Optional External Database (Cloud SQL / PostgreSQL) ---
DATABASE_URL=https://pfksirnbdbxkwtyczzqe.supabase.co
